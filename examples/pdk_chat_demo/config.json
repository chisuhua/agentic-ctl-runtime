{
  "$schema": "https://schemas.hydraforge.io/pdk_chat_demo-v1.json",
  "schema_version": "1.0",
  "app_id": "pdk_chat_demo",

  "providers": {
    "deepseek": {
      "api_key_env": "DEEPSEEK_API_KEY",
      "api_url": "https://api.deepseek.com",
      "api_endpoint": "/chat/completions",
      "models": {
        "deepseek-v4-flash": { "model": "deepseek-v4-flash", "max_tokens": 4096, "temperature": 0.7 }
      }
    },
    "minimax": {
      "api_key_env": "MINIMAX_API_KEY",
      "api_url": "https://api.minimax.chat",
      "api_endpoint": "/v1/chat/completions",
      "models": {
        "minimax-text-01": { "model": "minimax-text-01", "max_tokens": 4096, "temperature": 0.7 }
      }
    },
    "mock": {
      "models": {
        "test": { "model": "mock-llm-v1", "max_tokens": 1024 }
      }
    }
  },

  "agent": {
    "loop_type": "react",
    "provider": "deepseek",
    "model": "deepseek-v4-flash",
    "system_prompt": "You are a helpful coding assistant with access to tools.",
    "tools": ["fs/read", "fs/write", "shell/exec", "code_review/run"],
    "max_steps": 50,
    "timeout_ms": 300000,
    "budget_limit_usd": 1.0
  },

  "plugins": [
    {
      "id": "chat.loop",
      "path": "@CMAKE_BINARY_DIR@/pdk/loop_agent/libLoopAgent.so",
      "lifecycle": "lazy",
      "activation_events": ["onTool:loop/run"]
    },
    {
      "id": "infra.provider",
      "path": "@CMAKE_BINARY_DIR@/pdk/provider_agent/libProviderAgent.so",
      "lifecycle": "lazy",
      "activation_events": ["onTool:provider/resolve"]
    },
    {
      "id": "infra.session",
      "path": "@CMAKE_BINARY_DIR@/pdk/session_agent/libSessionAgent.so",
      "lifecycle": "lazy",
      "activation_events": ["onTool:session/persist"]
    },
    {
      "id": "infra.budget",
      "path": "@CMAKE_BINARY_DIR@/pdk/budget_agent/libBudgetAgent.so",
      "lifecycle": "lazy",
      "activation_events": ["onTool:budget/query"]
    },
    {
      "id": "tool.fs",
      "path": "@CMAKE_BINARY_DIR@/pdk/fs_tools/libFSTools.so"
    },
    {
      "id": "tool.shell",
      "path": "@CMAKE_BINARY_DIR@/pdk/shell_tools/libShellTools.so"
    },
    {
      "id": "skill.code_review",
      "path": "@SKILL_CODE_REVIEW_PATH@/SKILL.md",
      "type": "skill",
      "requires_isolation": true,
      "_comment": "SKILL.md 当前为 mock-only — 需要 SkillInterpreter (ADR-0055) 才能实际加载执行"
    },
    {
      "id": "skill.code_review_run",
      "path": "@SKILL_CODE_REVIEW_RUN_PATH@/code-review-run.skill.md",
      "type": "skill",
      "requires_isolation": true,
      "_comment": "命令式 .skill.md 示例 — 通过 SkillInterpreter 真实加载执行"
    }
  ],

  "orchestration": {
    "model": "event_driven",
    "entry": "user_input",
    "event_topics": [
      "user.input",
      "loop.turn.start",
      "loop.turn.end",
      "llm.request",
      "llm.response",
      "loop.decision",
      "tool.execution.start",
      "tool.execution.end",
      "loop.done",
      "loop.error",
      "session.persisted",
      "budget.checked"
    ]
  },

  "observability": {
    "otel_enabled": false,
    "endpoint": "http://localhost:4318",
    "sample_rate": 1.0,
    "export_format": "otlp+http"
  },

  "session": {
    "persist_dir": "~/.hydraforge/sessions/",
    "compact_threshold_tokens": 8000,
    "branch_on_user_request": true
  },

  "safety": {
    "default_trust_level": "medium",
    "high_risk_tools_require_approval": true,
    "budget_alerts": [
      {"threshold": 0.5, "severity": "warning"},
      {"threshold": 0.9, "severity": "critical"}
    ]
  }
}
